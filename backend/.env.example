# ============================================
# Smart JSS Readiness Checker — Backend Config
# ============================================
# These go into Hugging Face Space → Settings → Variables and secrets

# Google Apps Script Web App URL (see apps-script/Code.gs)
APPS_SCRIPT_URL=paste_your_apps_script_url_here

# Comma-separated allowed frontend origins
ALLOWED_ORIGINS=https://your-app.vercel.app

# Max upload size in MB (default 15)
MAX_FILE_SIZE_MB=15

# Confidence threshold below which review_required = Yes (default 0.70)
REVIEW_THRESHOLD=0.70
